# Modelo das variaveis de ambiente. Copie para .env.local e preencha.
# O .env.local fica fora do git; este arquivo nao contem segredo nenhum.
#
#   cp .env.example .env.local
#   set -a; source .env.local; set +a
#   ./mvnw spring-boot:run

# Sempre exporte junto com API_SECURITY_KEY: sem isso o profile e resolvido a
# partir da propria chave (ver nota sobre spring.profiles.active no README).
SPRING_PROFILES_ACTIVE=dev

# Gere uma chave nova com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECURITY_KEY=

DB_URL=jdbc:postgresql://host:5433/prisma-dev
DB_USER=
DB_PASS=
